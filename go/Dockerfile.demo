# Lightweight demo image: extension HTTP server only (POST /card, GET /state).
FROM golang:1.25.1-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /card-extension ./cmd/main.go

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /card-extension /card-extension
EXPOSE 8080
USER nonroot
ENTRYPOINT ["/card-extension"]
