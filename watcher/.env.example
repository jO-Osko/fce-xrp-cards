# Copy to watcher/.env (gitignored). Used when TEE_MODE=fcc for on-chain settle.

TEE_MODE=mock
TEE_CARD_URL=http://127.0.0.1:8080
# TEE_DIRECT_API_KEY=12345


# Filled by scripts/sync-config.mjs from extension/template/deployments/coston2.json.
INSTRUCTION_SENDER=
FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
FLARE_INSTRUCTION_TIMEOUT_MS=180000


# Private key of InstructionSender owner (deployer 0x0303685c…24fB7359).
# Export: cast wallet private-key --keystore ~/.foundry/keystores/xrpl-cc-deployer --password-file …
FLARE_SETTLER_PRIVATE_KEY=
